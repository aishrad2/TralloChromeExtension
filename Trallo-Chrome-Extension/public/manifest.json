{
    "manifest_version": 3,
    "name": "Trallo",
    "version": "1.0.0",
    "description": "Plan trips in a side panel. Every trip is one Google Sheet in your own Drive.",
    "key": "",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Open Trallo",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "permissions": [
        "identity",
        "identity.email",
        "storage",
        "sidePanel",
        "tabs"
    ],
    "host_permissions": [
        "https://sheets.googleapis.com/*",
        "https://www.googleapis.com/*"
    ],
    "oauth2": {
        "client_id": "316985151536-66u2ukta58l9kgbblps5mkun11td7n7o.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.file"
        ]
    }
}
